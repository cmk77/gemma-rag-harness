# .env.example — 복사해서 .env 로 쓰세요: cp .env.example .env
# backends.py 와 서빙 스크립트가 이 값들을 읽습니다.

# ── 모델 백엔드 ──────────────────────────────────────────
# 이 프로젝트는 vLLM 단일 경로를 표준으로 한다.
# 기본: Gemma 4 E4B + MTP(추측 디코딩) — 챗봇 수준 응답 속도.
LLM_BACKEND=vllm

# 모델 ID (HuggingFace repo) — Gemma 4는 Apache-2.0 공개(토큰 불필요)
#   gemma-4-E4B-it     : 8B, MTP로 빠름 (기본, 권장)
#   gemma-4-12B-it     : 12B, 품질↑ 속도↓
#   gemma-4-26B-A4B-it : 26B MoE, 품질 최고 속도 느림 VRAM 빡빡
LLM_MODEL=google/gemma-4-E4B-it

# ── 엔드포인트 (OpenAI 호환) ─────────────────────────────
VLLM_URL=http://localhost:8000/v1
LLM_API_KEY=EMPTY

# ── Elasticsearch ────────────────────────────────────────
ES_URL=http://localhost:9200
ES_INDEX=gemma_rag

# ── HuggingFace 토큰 ─────────────────────────────────────
# Gemma 4는 Apache-2.0 공개라 토큰이 없어도 받아진다.
# (bge-m3 임베딩 모델도 공개) 필요 시에만:
# HF_TOKEN=hf_xxxxxxxxxxxx
